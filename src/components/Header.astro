---
const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/menu', label: 'Menu' },
  { href: '/locations', label: 'Locations' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="sticky top-0 z-50 border-b border-ink/10 bg-cream/85 backdrop-blur-md transition-colors duration-300 dark:border-cream/10 dark:bg-espresso/85"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5">
      <span
        class="grid size-11 shrink-0 place-items-center rounded-organic bg-secondary text-cream shadow-sm transition-transform duration-300 group-hover:-rotate-6 dark:bg-secondary/80"
        aria-hidden="true"
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 22C7.6 17 5 13 5 9a7 7 0 0 1 14 0c0 4-2.6 8-7 13z" />
          <path d="M12 4v11" stroke="var(--color-secondary-strong)" stroke-width="1.5" stroke-linecap="round" fill="none" />
        </svg>
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-script text-lg leading-none text-primary">cafe</span>
        <span class="font-display text-2xl font-bold tracking-tight text-secondary dark:text-secondary-soft">TeeKaapi</span>
        <span class="text-[9px] font-semibold uppercase tracking-[0.35em] text-ink-soft dark:text-cream/50">Est. 2017</span>
      </span>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-1 md:flex">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            aria-current={currentPath === href ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition-colors duration-200',
              currentPath === href
                ? 'bg-secondary/10 text-secondary dark:bg-secondary/25 dark:text-secondary-soft'
                : 'text-ink-soft hover:bg-ink/5 hover:text-ink dark:text-cream/70 dark:hover:bg-cream/10 dark:hover:text-cream',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle dark mode"
        class="grid size-10 place-items-center rounded-full text-ink-soft transition-colors duration-200 hover:bg-ink/5 hover:text-ink dark:text-cream/70 dark:hover:bg-cream/10 dark:hover:text-cream"
      >
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
        </svg>
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
        </svg>
      </button>

      <a
        href="/contact#book"
        class="hidden rounded-organic bg-primary px-5 py-2.5 text-sm font-semibold text-cream shadow-md shadow-primary/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-strong hover:shadow-lg sm:inline-block"
      >
        Book a Table
      </a>

      <button
        type="button"
        data-nav-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="grid size-10 place-items-center rounded-full text-ink transition-colors duration-200 hover:bg-ink/5 md:hidden dark:text-cream dark:hover:bg-cream/10"
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile navigation"
    hidden
    class="border-t border-ink/10 px-4 pb-4 pt-2 md:hidden dark:border-cream/10"
  >
    <ul class="flex flex-col gap-1">
      {
        navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={currentPath === href ? 'page' : undefined}
              class="block rounded-xl px-4 py-3 font-medium text-ink transition-colors hover:bg-ink/5 dark:text-cream dark:hover:bg-cream/10"
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href="/contact#book"
          class="block rounded-organic bg-primary px-5 py-3 text-center font-semibold text-cream transition-colors hover:bg-primary-strong"
        >
          Book a Table
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const init = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    });

    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = document.querySelector<HTMLElement>('#mobile-nav');
    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        const open = panel.hidden;
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
    }
  };
  document.addEventListener('astro:page-load', init);
</script>
