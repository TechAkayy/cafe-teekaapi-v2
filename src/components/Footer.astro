---
const year = new Date().getFullYear();
---

<footer class="bg-secondary-strong text-cream/80 transition-colors duration-300 dark:bg-black/40">
  <!-- Newsletter -->
  <div class="border-b border-cream/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-12 text-center sm:px-6 md:flex-row md:justify-between md:text-left">
      <div>
        <p class="font-script text-2xl text-primary-soft">stay in the loop</p>
        <h2 class="font-display text-2xl font-bold text-cream">Fresh news, brewed monthly</h2>
        <p class="mt-1 text-sm text-cream/70">Seasonal menus, coffee drops and the odd free lamington.</p>
      </div>
      <form data-newsletter-form class="flex w-full max-w-md gap-2">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          placeholder="you@example.com"
          autocomplete="email"
          class="w-full rounded-full border border-cream/25 bg-cream/10 px-5 py-3 text-sm text-cream placeholder:text-cream/50 transition-colors focus:border-primary-soft"
        />
        <button
          type="submit"
          class="shrink-0 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-cream shadow transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-strong"
        >
          Subscribe
        </button>
      </form>
    </div>
    <p data-newsletter-status role="status" aria-live="polite" class="hidden pb-6 text-center text-sm font-semibold text-primary-soft"></p>
  </div>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="flex flex-col leading-none">
        <span class="font-script text-xl text-primary-soft">cafe</span>
        <span class="font-display text-3xl font-bold text-cream">TeeKaapi</span>
      </p>
      <p class="mt-4 max-w-sm text-sm leading-relaxed">
        Handcrafted coffee, delicious brunch and warm hospitality — all day, every day, since 2017.
      </p>
      <p class="mt-4 text-xs font-semibold uppercase tracking-[0.3em] text-primary-soft">
        Coffee · Brunch · Good Vibes
      </p>
    </div>

    <nav aria-label="Footer navigation">
      <h2 class="font-display text-sm font-bold uppercase tracking-widest text-cream">Explore</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="transition-colors hover:text-primary-soft" href="/about">About</a></li>
        <li><a class="transition-colors hover:text-primary-soft" href="/menu">Menu</a></li>
        <li><a class="transition-colors hover:text-primary-soft" href="/locations">Locations</a></li>
        <li><a class="transition-colors hover:text-primary-soft" href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="font-display text-sm font-bold uppercase tracking-widest text-cream">Say hello</h2>
      <address class="mt-4 space-y-2 text-sm not-italic">
        <p>18 Hardware Lane<br />Melbourne VIC 3000</p>
        <p>Open daily 7am–4pm</p>
        <p><a class="transition-colors hover:text-primary-soft" href="tel:+61390002017">(03) 9000 2017</a></p>
        <p><a class="transition-colors hover:text-primary-soft" href="mailto:hello@cafeteekaapi.com.au">hello@cafeteekaapi.com.au</a></p>
      </address>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 py-5 text-xs sm:flex-row sm:px-6">
      <p>&copy; {year} Cafe TeeKaapi. All rights reserved.</p>
      <p class="font-script text-base text-primary-soft">brewed with passion</p>
    </div>
  </div>
</footer>

<script>
  const init = () => {
    const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
    const status = document.querySelector<HTMLElement>('[data-newsletter-status]');
    if (!form || !status) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      status.textContent = 'You’re on the list — first brew of news lands next month!';
      status.classList.remove('hidden');
      form.reset();
    });
  };
  document.addEventListener('astro:page-load', init);
</script>
