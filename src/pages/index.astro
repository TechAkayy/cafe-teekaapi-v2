---
import BaseLayout from '../layouts/BaseLayout.astro';

const dishes = [
  {
    name: 'Signature Latte',
    desc: 'Single-origin espresso, velvet milk, latte art on every pour.',
    price: '$5.5',
    img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&h=700&q=80',
    alt: 'Latte with heart-shaped latte art beside a newspaper',
    tag: 'Barista’s pick',
  },
  {
    name: 'Great Days Big Brunch',
    desc: 'Free-range eggs, halloumi, smashed avo, sourdough, house relish.',
    price: '$26',
    img: 'https://images.unsplash.com/photo-1504754524776-8f4f37790ca0?auto=format&fit=crop&w=600&h=700&q=80',
    alt: 'A generous brunch plate with eggs and vegetables',
    tag: 'Most loved',
  },
  {
    name: 'Ricotta Hotcakes',
    desc: 'Lemon ricotta, seasonal berries, whipped honey butter.',
    price: '$22',
    img: 'https://images.unsplash.com/photo-1567620905732-2d1ec7ab7445?auto=format&fit=crop&w=600&h=700&q=80',
    alt: 'Stack of hotcakes with berries and syrup',
    tag: 'Weekend classic',
  },
];

const process = [
  { step: '01', title: 'Source', desc: 'Traceable single-origin greens, bought direct from growers we know by name.' },
  { step: '02', title: 'Roast', desc: 'Small-batch roasted locally each week — never more than ten days old.' },
  { step: '03', title: 'Pour', desc: 'Dialled in every morning, cupped blind, and poured with a steady hand.' },
];

const testimonials = [
  {
    quote: 'The kind of café you plan your whole morning around. Coffee is flawless, staff remember your name.',
    name: 'Sofia R.',
    detail: 'Regular since 2019',
  },
  {
    quote: 'Best brunch in the CBD, no contest. The ricotta hotcakes should be heritage listed.',
    name: 'Daniel K.',
    detail: 'Local food blogger',
  },
  {
    quote: 'Warm, welcoming, and the flat white is consistently perfect. My Saturday ritual.',
    name: 'Mei L.',
    detail: 'Hardware Lane neighbour',
  },
];

const whatson = [
  { title: 'Bottomless batch brew', detail: 'Free top-ups on filter before 9am, weekdays.' },
  { title: 'Saturday live sets', detail: 'Acoustic sessions in the Fitzroy courtyard from 10am.' },
  { title: 'New season, new stack', detail: 'Fig, walnut & honey hotcakes — while the figs last.' },
];

const gallery = [
  { img: 'https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=500&h=500&q=80', alt: 'Cosy café interior with warm lighting' },
  { img: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=500&h=500&q=80', alt: 'Espresso cup with coffee beans scattered around' },
  { img: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=500&h=500&q=80', alt: 'Restaurant tables set for service' },
  { img: 'https://images.unsplash.com/photo-1484723091739-30a097e8f929?auto=format&fit=crop&w=500&h=500&q=80', alt: 'French toast with fruit on a white plate' },
];
---

<BaseLayout
  title="Cafe TeeKaapi — Where Great Days Begin"
  description="Handcrafted coffee, delicious brunch and warm hospitality — all day, every day. Est. 2017 on Hardware Lane, Melbourne."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -right-24 top-16 size-80 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute -left-24 bottom-0 size-72 rounded-full bg-secondary/10 blur-3xl"></div>
      <svg class="animate-sway absolute right-10 top-24 h-24 w-16 text-secondary/30 max-md:hidden" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 22C7.6 17 5 13 5 9a7 7 0 0 1 14 0c0 4-2.6 8-7 13z" />
      </svg>
      <svg class="animate-drift absolute left-8 top-40 h-12 w-8 text-primary/30 max-md:hidden" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 22C7.6 17 5 13 5 9a7 7 0 0 1 14 0c0 4-2.6 8-7 13z" />
      </svg>
    </div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
      <div>
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.4em] text-secondary dark:text-secondary-soft" data-reveal>
          <svg class="size-4 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 22C7.6 17 5 13 5 9a7 7 0 0 1 14 0c0 4-2.6 8-7 13z" />
          </svg>
          Hardware Lane · Est. 2017
        </p>

        <h1 class="mt-6" data-reveal>
          <span class="font-script text-4xl text-primary sm:text-5xl">Slow mornings,</span><br />
          <span class="font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
            poured with <em class="text-secondary dark:text-secondary-soft">intention</em>
          </span>
        </h1>

        <p class="mt-6 max-w-md text-lg leading-relaxed text-ink-soft dark:text-cream/70" data-reveal>
          Single-origin coffee roasted down the road, brunch baked from scratch each morning, and a
          room that remembers your name. Melbourne's warmest corner since 2017.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4" data-reveal>
          <a
            href="/menu"
            class="group inline-flex items-center gap-2 rounded-organic bg-primary px-7 py-3.5 font-semibold text-cream shadow-lg shadow-primary/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-strong"
          >
            See the menu
            <svg class="size-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
          <a
            href="/contact#book"
            class="rounded-organic-r border-2 border-ink/20 px-7 py-3.5 font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:border-secondary hover:text-secondary dark:border-cream/25 dark:hover:border-secondary-soft dark:hover:text-secondary-soft"
          >
            Book a table
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft dark:text-cream/70" data-reveal>
          <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-primary" aria-hidden="true"></span>Open daily 7–4</li>
          <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-primary" aria-hidden="true"></span>Roasted locally</li>
          <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-primary" aria-hidden="true"></span>Baked fresh daily</li>
        </ul>
      </div>

      <div class="relative" data-reveal>
        <div class="overflow-hidden rounded-organic shadow-2xl">
          <img
            src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=900&h=1050&q=80"
            alt="A beautifully poured latte on a rustic wooden table"
            width="900"
            height="1050"
            class="aspect-[6/7] w-full object-cover transition-transform duration-700 hover:scale-105"
            fetchpriority="high"
          />
        </div>

        <figure class="absolute -bottom-8 -left-6 w-36 rotate-[-6deg] rounded-lg bg-paper p-2 pb-6 shadow-xl transition-transform duration-300 hover:rotate-0 sm:w-44 dark:bg-espresso-soft" aria-hidden="true">
          <img
            src="https://images.unsplash.com/photo-1453614512568-c4024d13c247?auto=format&fit=crop&w=400&h=300&q=80"
            alt=""
            width="400"
            height="300"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded object-cover"
          />
          <figcaption class="mt-1.5 text-center font-script text-lg text-ink-soft dark:text-cream/60">TeeKaapi</figcaption>
        </figure>

        <div class="absolute -right-4 top-6 grid size-24 place-items-center sm:size-28" aria-hidden="true">
          <svg class="animate-spin-slow absolute inset-0 size-full text-accent" viewBox="0 0 100 100">
            <defs>
              <path id="badge-circle" d="M 50,50 m -36,0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0" />
            </defs>
            <circle cx="50" cy="50" r="47" class="fill-accent/90" />
            <text class="fill-espresso font-body text-[11px] font-bold uppercase tracking-[0.3em]">
              <textPath href="#badge-circle">Brewed · with · Passion · </textPath>
            </text>
          </svg>
          <svg class="relative size-8 text-espresso" viewBox="0 0 24 24" fill="currentColor">
            <path d="M2 21h18v-2H2v2zM20 8h-2V5h2a2 2 0 0 1 0 3zm0-5h-2V2H4v11a4 4 0 0 0 4 4h6a4 4 0 0 0 4-4v-3h2a4 4 0 0 0 0-8z" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Story teaser -->
  <section class="bg-cream-soft py-20 transition-colors duration-300 dark:bg-black/20" aria-labelledby="story-heading">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2">
      <div class="relative" data-reveal>
        <img
          src="https://images.unsplash.com/photo-1521017432531-fbd92d768814?auto=format&fit=crop&w=800&h=600&q=80"
          alt="Friends enjoying coffee together at a café"
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
          class="rounded-organic object-cover shadow-xl"
        />
        <div aria-hidden="true" class="absolute -bottom-4 -right-4 -z-10 h-full w-full rounded-organic-r border-2 border-primary/40"></div>
      </div>
      <div data-reveal>
        <p class="font-script text-3xl text-primary">since 2017</p>
        <h2 id="story-heading" class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">
          A little lane, a lot of heart
        </h2>
        <p class="mt-5 leading-relaxed text-ink-soft dark:text-cream/70">
          TeeKaapi began as an espresso window barely wide enough for two elbows — and a queue that
          stretched down Hardware Lane anyway. Nine years on we're a proper room with a proper
          kitchen, but the promise hasn't moved: hand-poured coffee, bread baked before sunrise, and
          a greeting for half our guests by name.
        </p>
        <a href="/about" class="group mt-7 inline-flex items-center gap-2 font-semibold text-secondary transition-colors hover:text-secondary-strong dark:text-secondary-soft">
          Read our story
          <svg class="size-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- From the pass -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="dishes-heading">
    <div class="text-center" data-reveal>
      <p class="font-script text-3xl text-primary">from the pass</p>
      <h2 id="dishes-heading" class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">Made to be remembered</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-soft dark:text-cream/70">Three plates (and one pour) our regulars refuse to share.</p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        dishes.map(({ name, desc, price, img, alt, tag }) => (
          <li
            class="group relative overflow-hidden rounded-organic border border-ink/10 bg-paper shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-cream/10 dark:bg-espresso-soft"
            data-reveal
          >
            <span class="absolute left-4 top-4 z-10 rounded-full bg-cream/90 px-3 py-1 text-xs font-bold uppercase tracking-wide text-secondary shadow-sm dark:bg-espresso/90 dark:text-secondary-soft">{tag}</span>
            <div class="overflow-hidden">
              <img
                src={img}
                alt={alt}
                width="600"
                height="700"
                loading="lazy"
                decoding="async"
                class="aspect-[6/7] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-display text-xl font-bold">{name}</h3>
                <span class="shrink-0 font-display text-lg font-bold text-primary">{price}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft dark:text-cream/70">{desc}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-center" data-reveal>
      <a href="/menu" class="group inline-flex items-center gap-2 font-semibold text-secondary transition-colors hover:text-secondary-strong dark:text-secondary-soft">
        See the full menu
        <svg class="size-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </p>
  </section>

  <!-- How we brew -->
  <section class="bg-cream-soft py-20 transition-colors duration-300 dark:bg-black/20" aria-labelledby="process-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="text-center" data-reveal>
        <p class="font-script text-3xl text-primary">the ritual</p>
        <h2 id="process-heading" class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">From green bean to your cup</h2>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          process.map(({ step, title, desc }) => (
            <li class="rounded-organic border border-ink/10 bg-paper p-8 shadow-sm dark:border-cream/10 dark:bg-espresso-soft" data-reveal>
              <p class="font-display text-4xl font-bold text-primary/30" aria-hidden="true">{step}</p>
              <h3 class="mt-3 font-display text-xl font-bold">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft dark:text-cream/70">{desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Gallery -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="gallery-heading">
    <div class="text-center" data-reveal>
      <p class="font-script text-3xl text-primary">moments</p>
      <h2 id="gallery-heading" class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">Life at TeeKaapi</h2>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        gallery.map(({ img, alt }, i) => (
          <li class:list={['overflow-hidden rounded-organic shadow-sm', i % 2 === 1 && 'md:mt-8']} data-reveal>
            <img
              src={img}
              alt={alt}
              width="500"
              height="500"
              loading="lazy"
              decoding="async"
              class="aspect-square w-full object-cover transition-transform duration-500 hover:scale-105"
            />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Testimonials -->
  <section class="bg-cream-soft py-20 transition-colors duration-300 dark:bg-black/20" aria-labelledby="testimonials-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="text-center" data-reveal>
        <p class="font-script text-3xl text-primary">kind words</p>
        <h2 id="testimonials-heading" class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">From our regulars</h2>
      </div>

      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {
          testimonials.map(({ quote, name, detail }) => (
            <li class="rounded-organic border border-ink/10 bg-paper p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-cream/10 dark:bg-espresso-soft" data-reveal>
              <div class="flex gap-1 text-accent" role="img" aria-label="5 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17l-6.2 3.9 1.6-7L2 9.2l7.1-.6L12 2z" />
                  </svg>
                ))}
              </div>
              <blockquote class="mt-4">
                <p class="leading-relaxed text-ink-soft dark:text-cream/75">“{quote}”</p>
              </blockquote>
              <p class="mt-5 font-display font-bold">{name}</p>
              <p class="text-sm text-ink-soft dark:text-cream/60">{detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What's on -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="whatson-heading">
    <div class="text-center" data-reveal>
      <p class="font-script text-3xl text-primary">what's on</p>
      <h2 id="whatson-heading" class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">Happening right now</h2>
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        whatson.map(({ title, detail }) => (
          <li class="flex items-start gap-4 rounded-organic border border-ink/10 bg-paper p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-cream/10 dark:bg-espresso-soft" data-reveal>
            <span class="grid size-10 shrink-0 place-items-center rounded-organic bg-primary/15 text-primary" aria-hidden="true">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 3v6a6 6 0 0 0 12 0V3M6 3H4m2 0h12m2 0h-2M8 13v4m4-4v4m4-4v4" />
              </svg>
            </span>
            <div>
              <h3 class="font-display text-lg font-bold">{title}</h3>
              <p class="mt-1 text-sm text-ink-soft dark:text-cream/70">{detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Visit us -->
  <section class="px-4 pb-20 sm:px-6" aria-labelledby="visit-heading">
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-organic bg-secondary px-8 py-14 text-cream shadow-2xl md:grid-cols-2 md:px-14 dark:bg-secondary-strong" data-reveal>
      <svg class="animate-sway absolute -right-8 -top-8 size-40 text-cream/10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 22C7.6 17 5 13 5 9a7 7 0 0 1 14 0c0 4-2.6 8-7 13z" />
      </svg>
      <div>
        <p class="font-script text-3xl text-primary-soft">come say hi</p>
        <h2 id="visit-heading" class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">Visit us on Hardware Lane</h2>
        <p class="mt-4 max-w-md leading-relaxed text-cream/80">
          Open daily 7am–4pm. Two more rooms in Fitzroy and South Melbourne — same beans, same welcome.
        </p>
        <div class="mt-7 flex flex-wrap gap-4">
          <a href="/locations" class="rounded-organic bg-cream px-7 py-3.5 font-semibold text-secondary transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-soft">
            All locations
          </a>
          <a href="/contact#book" class="rounded-organic-r border-2 border-cream/40 px-7 py-3.5 font-semibold text-cream transition-all duration-200 hover:-translate-y-0.5 hover:border-cream">
            Book a table
          </a>
        </div>
      </div>
      <img
        src="https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=800&h=600&q=80"
        alt="Barista at work behind the espresso machine"
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-organic-r object-cover shadow-xl"
      />
    </div>
  </section>
</BaseLayout>
