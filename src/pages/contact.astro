---
import BaseLayout from '../layouts/BaseLayout.astro';

const hours = [
  { day: 'Monday', lanes: '7am – 4pm', south: 'Closed' },
  { day: 'Tuesday', lanes: '7am – 4pm', south: 'Closed' },
  { day: 'Wednesday', lanes: '7am – 4pm', south: '7am – 3pm' },
  { day: 'Thursday', lanes: '7am – 4pm', south: '7am – 3pm' },
  { day: 'Friday', lanes: '7am – 4pm', south: '7am – 3pm' },
  { day: 'Saturday', lanes: '7am – 4pm', south: '7am – 3pm' },
  { day: 'Sunday', lanes: '7am – 4pm', south: '7am – 3pm' },
];

const faqs = [
  { q: 'Do you take bookings?', a: 'Yes — for groups of any size at Hardware Lane and Fitzroy. South Melbourne is walk-in only (it moves quickly, promise).' },
  { q: 'Are dogs welcome?', a: 'Outside seats at every venue, plus the Fitzroy courtyard. Water bowls always out.' },
  { q: 'Do you cater for dietary needs?', a: 'Plenty — vegan, vegetarian and gluten-free options are marked on the menu, and most dishes adapt happily. Just tell your server.' },
  { q: 'Is there Wi-Fi?', a: 'Yes, free and reliable at all three rooms. Laptops welcome before 11am on weekdays.' },
  { q: 'Can you host events?', a: 'Fitzroy takes evening bookings for private events of up to 60. Email us for the events pack.' },
  { q: 'Do you sell beans?', a: 'Yes — our house blend and rotating single origins, whole bean or ground, at every counter.' },
];
---

<BaseLayout
  title="Contact & Bookings — Cafe TeeKaapi"
  description="Book a table at Cafe TeeKaapi or get in touch — Hardware Lane, Fitzroy and South Melbourne. Open daily from 7am."
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -left-20 top-8 size-64 rounded-full bg-primary/10 blur-3xl"></div>
      <svg class="animate-drift absolute right-12 top-16 h-14 w-10 text-secondary/25 max-md:hidden" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 22C7.6 17 5 13 5 9a7 7 0 0 1 14 0c0 4-2.6 8-7 13z" />
      </svg>
    </div>
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
      <p class="font-script text-3xl text-primary" data-reveal>say hello</p>
      <h1 class="mt-2 font-display text-4xl font-bold tracking-tight sm:text-5xl" data-reveal>We'd love to see you</h1>
      <p class="mx-auto mt-5 max-w-xl text-ink-soft dark:text-cream/70" data-reveal>
        Book a table, plan an event, or just ask about the beans.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 pb-20 sm:px-6 lg:grid-cols-5">
    <!-- Info -->
    <div class="space-y-6 lg:col-span-2">
      <div class="rounded-organic border border-ink/10 bg-paper p-7 shadow-sm dark:border-cream/10 dark:bg-espresso-soft" data-reveal>
        <h2 class="font-display text-lg font-bold text-secondary dark:text-secondary-soft">Head office &amp; original room</h2>
        <address class="mt-3 text-sm not-italic leading-relaxed text-ink-soft dark:text-cream/75">
          18 Hardware Lane<br />Melbourne VIC 3000<br />
          <a href="https://maps.google.com/?q=Hardware+Lane+Melbourne" rel="noopener noreferrer" target="_blank" class="mt-1 inline-block font-semibold text-primary underline-offset-2 hover:underline">Open in Maps ↗</a>
        </address>
      </div>

      <div class="rounded-organic border border-ink/10 bg-paper p-7 shadow-sm dark:border-cream/10 dark:bg-espresso-soft" data-reveal>
        <h2 class="font-display text-lg font-bold text-secondary dark:text-secondary-soft">Reach us</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-soft dark:text-cream/75">
          <li><a href="tel:+61390002017" class="transition-colors hover:text-primary">(03) 9000 2017</a></li>
          <li><a href="mailto:hello@cafeteekaapi.com.au" class="transition-colors hover:text-primary">hello@cafeteekaapi.com.au</a></li>
          <li><a href="https://instagram.com" rel="noopener noreferrer" target="_blank" class="transition-colors hover:text-primary">@cafeteekaapi ↗</a></li>
        </ul>
      </div>

      <div class="rounded-organic border border-ink/10 bg-paper p-7 shadow-sm dark:border-cream/10 dark:bg-espresso-soft" data-reveal>
        <h2 class="font-display text-lg font-bold text-secondary dark:text-secondary-soft">Large groups &amp; events</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-cream/75">
          Parties of 9+ or a private room? Email
          <a href="mailto:events@cafeteekaapi.com.au" class="font-semibold text-primary underline-offset-2 hover:underline">events@cafeteekaapi.com.au</a>
          and we'll sort the rest.
        </p>
      </div>
    </div>

    <!-- Booking form -->
    <div id="book" class="scroll-mt-24 lg:col-span-3" data-reveal>
      <form
        data-booking-form
        class="grid gap-5 rounded-organic border border-ink/10 bg-paper p-8 shadow-sm sm:grid-cols-2 dark:border-cream/10 dark:bg-espresso-soft"
      >
        <div class="sm:col-span-2">
          <p class="font-script text-2xl text-primary">reserve a spot</p>
          <h2 class="font-display text-2xl font-bold">Book a table</h2>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="bk-name" class="text-sm font-semibold">Name</label>
          <input id="bk-name" name="name" type="text" required autocomplete="name"
            class="rounded-xl border border-ink/15 bg-cream px-4 py-3 text-sm transition-colors focus:border-primary dark:border-cream/15 dark:bg-espresso" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="bk-phone" class="text-sm font-semibold">Phone</label>
          <input id="bk-phone" name="phone" type="tel" required autocomplete="tel"
            class="rounded-xl border border-ink/15 bg-cream px-4 py-3 text-sm transition-colors focus:border-primary dark:border-cream/15 dark:bg-espresso" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="bk-venue" class="text-sm font-semibold">Venue</label>
          <select id="bk-venue" name="venue"
            class="rounded-xl border border-ink/15 bg-cream px-4 py-3 text-sm transition-colors focus:border-primary dark:border-cream/15 dark:bg-espresso">
            <option selected>Hardware Lane</option>
            <option>Fitzroy</option>
          </select>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="bk-guests" class="text-sm font-semibold">Guests</label>
          <select id="bk-guests" name="guests"
            class="rounded-xl border border-ink/15 bg-cream px-4 py-3 text-sm transition-colors focus:border-primary dark:border-cream/15 dark:bg-espresso">
            <option>1–2</option>
            <option selected>3–4</option>
            <option>5–8</option>
            <option>9+ (we’ll call you)</option>
          </select>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="bk-date" class="text-sm font-semibold">Date</label>
          <input id="bk-date" name="date" type="date" required
            class="rounded-xl border border-ink/15 bg-cream px-4 py-3 text-sm transition-colors focus:border-primary dark:border-cream/15 dark:bg-espresso" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="bk-time" class="text-sm font-semibold">Time</label>
          <input id="bk-time" name="time" type="time" min="07:00" max="15:30" required
            class="rounded-xl border border-ink/15 bg-cream px-4 py-3 text-sm transition-colors focus:border-primary dark:border-cream/15 dark:bg-espresso" />
        </div>
        <div class="flex flex-col gap-1.5 sm:col-span-2">
          <label for="bk-notes" class="text-sm font-semibold">Notes <span class="font-normal text-ink-soft dark:text-cream/60">(optional)</span></label>
          <input id="bk-notes" name="notes" type="text" placeholder="Birthday, pram, window seat…"
            class="rounded-xl border border-ink/15 bg-cream px-4 py-3 text-sm transition-colors focus:border-primary dark:border-cream/15 dark:bg-espresso" />
        </div>

        <div class="sm:col-span-2">
          <button type="submit"
            class="w-full rounded-organic bg-primary px-7 py-3.5 font-semibold text-cream shadow-lg shadow-primary/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-strong">
            Request booking
          </button>
          <p data-form-status role="status" aria-live="polite" class="mt-3 hidden text-center text-sm font-semibold text-secondary dark:text-secondary-soft"></p>
        </div>
      </form>
    </div>
  </section>

  <!-- Opening hours -->
  <section class="bg-cream-soft py-20 transition-colors duration-300 dark:bg-black/20" aria-labelledby="hours-heading">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="text-center" data-reveal>
        <p class="font-script text-3xl text-primary">when to find us</p>
        <h2 id="hours-heading" class="mt-1 font-display text-3xl font-bold tracking-tight sm:text-4xl">Opening hours</h2>
      </div>
      <div class="mt-10 overflow-hidden rounded-organic border border-ink/10 bg-paper shadow-sm dark:border-cream/10 dark:bg-espresso-soft" data-reveal>
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Opening hours by venue</caption>
          <thead>
            <tr class="border-b border-ink/10 text-xs uppercase tracking-wider text-ink-soft dark:border-cream/10 dark:text-cream/60">
              <th scope="col" class="px-5 py-3 font-semibold">Day</th>
              <th scope="col" class="px-5 py-3 font-semibold">Hardware Lane &amp; Fitzroy</th>
              <th scope="col" class="px-5 py-3 font-semibold">South Melbourne</th>
            </tr>
          </thead>
          <tbody>
            {hours.map(({ day, lanes, south }) => (
              <tr class="border-b border-ink/5 last:border-0 dark:border-cream/5">
                <th scope="row" class="px-5 py-3 font-semibold text-ink dark:text-cream">{day}</th>
                <td class="px-5 py-3 text-ink-soft dark:text-cream/75">{lanes}</td>
                <td class="px-5 py-3 text-ink-soft dark:text-cream/75">{south}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6" aria-labelledby="faq-heading">
    <div class="text-center" data-reveal>
      <p class="font-script text-3xl text-primary">good to know</p>
      <h2 id="faq-heading" class="mt-1 font-display text-3xl font-bold tracking-tight sm:text-4xl">Questions, answered</h2>
    </div>
    <div class="mt-10 space-y-4">
      {
        faqs.map(({ q, a }) => (
          <details class="group rounded-organic border border-ink/10 bg-paper px-6 py-4 shadow-sm transition-shadow hover:shadow-md dark:border-cream/10 dark:bg-espresso-soft" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-bold marker:hidden">
              {q}
              <svg class="size-5 shrink-0 text-primary transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14m-7-7h14" />
              </svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-cream/70">{a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <script>
    const init = () => {
      const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
      const status = form?.querySelector<HTMLElement>('[data-form-status]');
      if (!form || !status) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        status.textContent = 'Booking request received! We’ll confirm by text shortly.';
        status.classList.remove('hidden');
        form.reset();
      });
    };
    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
